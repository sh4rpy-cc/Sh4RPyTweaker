<UserControl x:Class="Sh4RPyTweaker.Views.ProcessesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <Grid Margin="0,0,0,8">
            <TextBlock Text="Процессы" Style="{StaticResource SectionTitle}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Button x:Name="RefreshBtn" Content="Обновить" Style="{StaticResource AccentButtonStyle}"
                        Margin="0,0,8,0" Click="Refresh_Click" />
                <Button Content="Завершить" Style="{StaticResource DangerButtonStyle}"
                        Margin="0,0,8,0" Click="Kill_Click" />
                <Button Content="Расположение файла" Style="{StaticResource SecondaryButtonStyle}"
                        Click="OpenLocation_Click" />
            </StackPanel>
        </Grid>
        <TextBlock x:Name="Status" Text="Обновление списка..." Style="{StaticResource HintText}" Margin="0,0,0,10" />

        <Border Style="{StaticResource Card}" Padding="8">
            <ListView x:Name="ProcList" Style="{StaticResource PlainListStyle}"
                      ItemContainerStyle="{StaticResource ListViewItemStyle}"
                      SelectionMode="Extended" MaxHeight="520">
                <ListView.Resources>
                    <Style TargetType="{x:Type GridViewColumnHeader}" BasedOn="{StaticResource GridColHeaderStyle}" />
                </ListView.Resources>
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Имя" Width="240" DisplayMemberBinding="{Binding Name}" />
                        <GridViewColumn Header="PID" Width="70" DisplayMemberBinding="{Binding Id}" />
                        <GridViewColumn Header="CPU" Width="80" DisplayMemberBinding="{Binding CpuText}" />
                        <GridViewColumn Header="Память" Width="100" DisplayMemberBinding="{Binding MemoryText}" />
                        <GridViewColumn Header="Потоков" Width="70" DisplayMemberBinding="{Binding Threads}" />
                        <GridViewColumn Header="Запущен" Width="140" DisplayMemberBinding="{Binding StartTime}" />
                        <GridViewColumn Header="Тип" Width="90">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="Системный" Foreground="{StaticResource WarningBrush}"
                                               ToolTip="Системный процесс: завершение может привести к сбою Windows"
                                               FontSize="11" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsProtected}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>
    </StackPanel>
</UserControl>

