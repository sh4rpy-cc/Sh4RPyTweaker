<UserControl x:Class="Sh4RPyTweaker.Views.PerformanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Sh4RPyTweaker.Controls">
    <StackPanel>
        <Grid Margin="0,0,0,8">
            <TextBlock Text="Производительность" Style="{StaticResource SectionTitle}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Button Content="Применить выбранные" Style="{StaticResource AccentButtonStyle}"
                        Margin="0,0,8,0" Click="ApplySelected_Click" />
                <Button Content="Применить все" Style="{StaticResource SecondaryButtonStyle}"
                        Margin="0,0,8,0" Click="ApplyAll_Click" />
                <Button Content="Отключить все" Style="{StaticResource SecondaryButtonStyle}"
                        Click="Reset_Click" />
            </StackPanel>
        </Grid>
        <TextBlock Text="Отметьте нужные твики галочкой и нажмите «Применить выбранные», либо включайте их мгновенно переключателем."
                   Style="{StaticResource HintText}" Margin="0,0,0,14" />
        <ItemsControl x:Name="Rows">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <controls:SettingRow Title="{Binding Name}"
                                         Description="{Binding Description}"
                                         Glyph="{Binding Glyph}"
                                         HasWarning="{Binding HasWarning}"
                                         IsSelected="{Binding IsSelected, Mode=TwoWay}"
                                         IsOn="{Binding IsApplied, Mode=TwoWay}" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>

